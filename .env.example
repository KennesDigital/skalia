# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Ninox ─────────────────────────────────────────────────────────────────────
# API-Schlüssel: Ninox → Team-Einstellungen → Integrationen → API-Schlüssel
NINOX_API_KEY=dein-ninox-api-schluessel

# Team-ID: sichtbar in der Ninox-URL  https://app.ninox.com/<TEAM_ID>/...
NINOX_TEAM_ID=deine-team-id

# Datenbank-ID: sichtbar in der Ninox-URL  .../databases/<DATABASE_ID>/...
NINOX_DATABASE_ID=deine-datenbank-id

# Name der Tabelle in Ninox (Standard: Aufträge)
NINOX_TABLE_NAME=Aufträge

# Feldname der Auftragsnummer in Ninox (Standard: Auftragsnummer)
NINOX_ORDER_FIELD=Auftragsnummer

# Feldname des Dropbox-Pfads in Ninox (Standard: Dropboxpfad)
NINOX_DROPBOX_FIELD=Dropboxpfad

# ── Dropbox ───────────────────────────────────────────────────────────────────
# Option A – kurzlebiger Access Token (läuft nach 4 h ab, nur für Tests):
DROPBOX_ACCESS_TOKEN=

# Option B – langfristiger Refresh Token (empfohlen für Produktion):
# Alle drei Felder müssen gesetzt sein, damit Option B aktiv ist.
# Refresh Token erhält man über den OAuth2-Flow mit access_type=offline.
DROPBOX_REFRESH_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# ── Entwicklungsmodus ─────────────────────────────────────────────────────────
# Dropbox-Upload überspringen (z. B. zum lokalen Testen): true | false
SKIP_DROPBOX=false
